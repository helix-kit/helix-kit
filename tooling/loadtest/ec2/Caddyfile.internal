# Caddyfile for a load-test box with no public DNS/ACME: serve HTTPS with Caddy's
# internal CA (real TLS 1.3 handshake + decryption cost, self-signed cert that
# clients skip-verify). Mounted at /etc/helix/Caddyfile (ro), overriding the
# baked ACME Caddyfile. Replace the domain with your box's nip.io name.
#
# The upstream placeholders are filled from the caddy unit's Environment=
# (NEXTJS_UPSTREAM=127.0.0.1:3000, HELIX_SERVER_UPSTREAM=127.0.0.1:4000).
{
	local_certs
}

REPLACE-ME.nip.io {
	encode zstd gzip
	tls internal

	@helix_server path /api/health /api/ice-config /ws /stream/client
	handle @helix_server {
		reverse_proxy {$HELIX_SERVER_UPSTREAM}
	}
	handle_path /turbo-cache* {
		reverse_proxy {$TURBO_CACHE_UPSTREAM}
	}
	handle {
		reverse_proxy {$NEXTJS_UPSTREAM}
	}
}
