# Azure Bot registration credentials (from the Azure "Azure Bot" resource).
# createTeamsAdapter() auto-detects these.
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
TEAMS_APP_PASSWORD=your-client-secret

# Only needed for SingleTenant bots (and Graph-based history / user lookup).
# TEAMS_APP_TENANT_ID=00000000-0000-0000-0000-000000000000
# TEAMS_APP_TYPE=SingleTenant

# --- Slack ------------------------------------------------------------------
# Bot User OAuth Token from "OAuth & Permissions" (xoxb-...). Required.
SLACK_BOT_TOKEN=xoxb-...
#
# Socket mode (recommended for local/personal use): set the App-Level Token from
# "Basic Information" -> App-Level Tokens (xapp-..., scope connections:write).
# When set, the bot connects over a WebSocket — no tunnel or request URL needed.
SLACK_APP_TOKEN=xapp-...
#
# Webhook mode instead (leave SLACK_APP_TOKEN unset): Slack POSTs to /slack/events
# and this signing secret verifies the requests ("Basic Information" -> Signing Secret).
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# Display name the SDK uses to recognise @mentions of the bot.
BOT_USER_NAME=helix

# HTTP port the local server binds (the Cloudflare tunnel forwards to this).
PORT=3978
