        "showHeader": true
      },
      "targets": [
        {
          "expr": "topk(50, sum by (requestId, method, path) (count_over_time({service_name=\"helix\"} | json | requestId != \"\" | __error__=\"\" [$__range])))",
          "refId": "A"
        }
      ],
      "title": "Cloud app log volume by request id",
      "type": "table"
    },
