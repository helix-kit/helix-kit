# helix-server — headless data plane (device WS gateway, MQTT bridge, event
# writer). Copy to `.env` and fill in, or let `helix appliance up` generate a
# `.env` wired to the local appliance (it also exports the mTLS PKI to disk).
#
# Values marked [appliance] are (re)written from the running appliance container
# by `helix appliance up`. The cert paths point at files exported under
# `.dev-pki/`. Everything else is yours to edit.

# ---- [appliance] Postgres + auth secret (shared with the cloud app) ----
DATABASE_URL=postgres://helix:PASSWORD@127.0.0.1:25432/helix
BETTER_AUTH_SECRET=change-me

# Listen ports for this process (bound on the host in local dev).
HELIX_HTTP_PORT=4000
DEVICE_MTLS_PORT=4001

# ---- [appliance] Kafka/Redpanda event queue over the mapped host port ----
EVENT_QUEUE_BROKERS=127.0.0.1:29092
EVENT_QUEUE_TOPIC=helix.device-events.v1

# ---- [appliance] MQTT broker (mTLS) over the mapped host port ----
MQTT_BROKER_URL=mqtts://127.0.0.1:28884
MQTT_TLS_SERVER_NAME=localhost
MQTT_TLS_CA_CERT_PATH=.dev-pki/root_ca.crt
MQTT_TLS_CLIENT_CERT_PATH=.dev-pki/client.crt
MQTT_TLS_CLIENT_KEY_PATH=.dev-pki/client.key

# ---- [appliance] step-ca device provisioning over the mapped host port ----
MQTT_STEP_CA_URL=https://127.0.0.1:29000
MQTT_STEP_CA_ROOT_CERT_PATH=.dev-pki/root_ca.crt
MQTT_STEP_CA_DEVICE_PROVISIONER_NAME=helix-device
MQTT_STEP_CA_DEVICE_PROVISIONER_JWK_PATH=.dev-pki/device-provisioner.jwk.json

# ---- [appliance] device mTLS ingestion listener certs ----
DEVICE_MTLS_CA_CERT_PATH=.dev-pki/root_ca.crt
DEVICE_MTLS_SERVER_CERT_PATH=.dev-pki/server.crt
DEVICE_MTLS_SERVER_KEY_PATH=.dev-pki/server.key
# CRL enforced on the mTLS listener (revoked device certs rejected). Optional:
# unset disables CRL checking; the appliance keeps this file fresh via crl-sync.
DEVICE_MTLS_CRL_PATH=.dev-pki/crl.pem

# Object storage. FS keeps blobs on local disk (default for dev).
STORAGE_PROVIDER=FS
FS_STORAGE_ROOT=.dev-storage
