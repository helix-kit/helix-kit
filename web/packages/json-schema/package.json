{
  "name": "@helix-hq/json-schema",
  "version": "0.1.1",
  "description": "Author JSON Schemas in React \u2014 a property-list builder, a schema-aware Monaco editor, and a TypeScript emitter.",
  "keywords": [
    "json-schema",
    "schema-editor",
    "monaco",
    "react",
    "typescript",
    "zod"
  ],
  "license": "MIT",
  "author": "Hardik Jain",
  "homepage": "https://github.com/helix-kit/helix-kit/tree/main/web/packages/json-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helix-kit/helix-kit.git",
    "directory": "web/packages/json-schema"
  },
  "bugs": {
    "url": "https://github.com/helix-kit/helix-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./builder": {
      "import": "./src/builder.tsx",
      "types": "./src/builder.tsx"
    },
    "./editor": {
      "import": "./src/editor.tsx",
      "types": "./src/editor.tsx"
    },
    "./ai": {
      "import": "./src/ai.ts",
      "types": "./src/ai.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./builder": {
        "import": "./dist/builder.js",
        "types": "./dist/builder.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.js",
        "types": "./dist/editor.d.ts"
      },
      "./ai": {
        "import": "./dist/ai.js",
        "types": "./dist/ai.d.ts"
      }
    }
  },
  "dependencies": {
    "@helix-hq/ai-kit": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@helix-hq/design-system": "workspace:^",
    "lucide-react": "^0.400.0 || ^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-resizable-panels": "^4.12.1"
  },
  "devDependencies": {
    "@helix-hq/design-system": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.6.0",
    "lucide-react": "^1.23.0",
    "react-resizable-panels": "^4.12.1",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "@helix-hq/design-system": {
      "optional": true
    }
  }
}
