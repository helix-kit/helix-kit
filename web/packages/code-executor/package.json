{
  "name": "@helix-hq/code-executor",
  "version": "0.1.0",
  "description": "Run untrusted TypeScript in a QuickJS WASM sandbox, typed by JSON Schema, with a Monaco editor for authoring it.",
  "keywords": [
    "sandbox",
    "quickjs",
    "wasm",
    "untrusted-code",
    "typescript",
    "monaco",
    "json-schema"
  ],
  "license": "MIT",
  "author": "Hardik Jain",
  "homepage": "https://github.com/helix-kit/helix-kit/tree/main/web/packages/code-executor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helix-kit/helix-kit.git",
    "directory": "web/packages/code-executor"
  },
  "bugs": {
    "url": "https://github.com/helix-kit/helix-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./editor": {
      "import": "./src/editor.tsx",
      "types": "./src/editor.tsx"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    },
    "./ai": {
      "import": "./src/ai.ts",
      "types": "./src/ai.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.js",
        "types": "./dist/editor.d.ts"
      },
      "./types": {
        "import": "./dist/types.js",
        "types": "./dist/types.d.ts"
      },
      "./ai": {
        "import": "./dist/ai.js",
        "types": "./dist/ai.d.ts"
      }
    }
  },
  "dependencies": {
    "@helix-hq/ai-kit": "workspace:*",
    "@helix-hq/json-schema": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "quickjs-emscripten": "^0.32.0",
    "sucrase": "^3.35.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.6.0",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
