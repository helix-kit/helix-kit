# Points at the catalog's own Postgres container (docker-compose.yml), not the appliance.
DATABASE_URL=postgresql://catalog:catalog@localhost:25433/hardware_catalog
NEXT_PUBLIC_BASE_URL=http://localhost:3100

# Object storage, shared with the rest of Helix. Copy these from web/apps/helix/.env
# (provisioned by `helix appliance up`, or the production values for the live bucket).
STORAGE_PROVIDER=S3
STORAGE_PUBLIC_ASSET_URL=https://assets.helix-kit.com
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
