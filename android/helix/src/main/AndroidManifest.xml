<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE runtime permissions (declared here so consumers inherit them). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Pre-Android 12 companion scanning required a location permission. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- USB host mode for the USB-serial transport (declared here so consumers
         inherit it). Optional so BLE/MQTT-only devices still install. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

</manifest>
