#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
"""Drive an SSH keyboard-interactive login over a PTY.

OpenSSH reads keyboard-interactive prompts from the terminal, so a pipe on stdin
is not enough to answer them. This attaches a real PTY, answers prompts from
--answer rules, and prints the whole transcript for the test harness to assert on.

Exit code is ssh's own, so a failed authentication stays a failed command.
"""

from __future__ import annotations

import argparse
import sys

import pexpect


def main() -> int:
    parser = argparse.ArgumentParser(description="drive an ssh keyboard-interactive login")
    parser.add_argument("target", help="user@host")
    parser.add_argument("--port", default="22")
    parser.add_argument(
        "--answer",
        action="append",
        default=[],
        metavar="PATTERN=VALUE",
        help="reply VALUE when the transcript matches PATTERN (repeatable, in order)",
    )
    parser.add_argument("--timeout", type=int, default=60)
    args = parser.parse_args()

    rules = []
    for rule in args.answer:
        pattern, _, value = rule.partition("=")
        rules.append((pattern, value))

    command = [
        "ssh",
        "-p",
        args.port,
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "PreferredAuthentications=keyboard-interactive",
        "-o",
        "NumberOfPasswordPrompts=1",
        args.target,
    ]

    child = pexpect.spawn(command[0], command[1:], timeout=args.timeout, encoding="utf-8")
    transcript: list[str] = []
    child.logfile_read = _Tee(transcript)

    for pattern, value in rules:
        try:
            child.expect(pattern)
        except (pexpect.EOF, pexpect.TIMEOUT):
            # The prompt never arrived; let the transcript below explain why.
            break
        child.sendline(value)

    child.expect(pexpect.EOF)
    child.close()

    sys.stdout.write("".join(transcript))
    sys.stdout.flush()
    return child.exitstatus if child.exitstatus is not None else 1


class _Tee:
    """Collect the PTY transcript without echoing it twice."""

    def __init__(self, sink: list[str]) -> None:
        self._sink = sink

    def write(self, data: str) -> None:
        self._sink.append(data)

    def flush(self) -> None:
        pass


if __name__ == "__main__":
    sys.exit(main())
