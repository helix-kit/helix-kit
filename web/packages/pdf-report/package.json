{
  "name": "@helix/pdf-report",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:live": "vitest run ai.live"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./browser": {
      "import": "./src/browser.tsx",
      "types": "./src/browser.tsx"
    },
    "./components": {
      "import": "./src/components/registry.ts",
      "types": "./src/components/registry.ts"
    },
    "./editor": {
      "import": "./src/editor.tsx",
      "types": "./src/editor.tsx"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    },
    "./ai": {
      "import": "./src/ai.ts",
      "types": "./src/ai.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./browser": {
        "import": "./dist/browser.js",
        "types": "./dist/browser.d.ts"
      },
      "./components": {
        "import": "./dist/components/registry.js",
        "types": "./dist/components/registry.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.js",
        "types": "./dist/editor.d.ts"
      },
      "./server": {
        "import": "./dist/server.js",
        "types": "./dist/server.d.ts"
      },
      "./ai": {
        "import": "./dist/ai.js",
        "types": "./dist/ai.d.ts"
      }
    }
  },
  "dependencies": {
    "@helix/ai-kit": "workspace:*",
    "@helix/code-executor": "workspace:*",
    "@helix/json-schema": "workspace:*",
    "@json-render/core": "^0.19.0",
    "@json-render/react-pdf": "^0.19.0",
    "@react-pdf/renderer": "^4.5.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ai": "^7.0.42",
    "eslint": "^10.6.0",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
