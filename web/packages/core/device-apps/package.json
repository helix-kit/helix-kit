{
  "name": "@helix/device-apps",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./trpc": {
      "import": "./src/trpc.tsx",
      "types": "./src/trpc.tsx"
    },
    "./header-portal": {
      "import": "./src/header-portal.tsx",
      "types": "./src/header-portal.tsx"
    },
    "./esp32-flasher/router": {
      "import": "./src/esp32-flasher/router.ts",
      "types": "./src/esp32-flasher/router.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./trpc": {
        "import": "./dist/trpc.js",
        "types": "./dist/trpc.d.ts"
      },
      "./header-portal": {
        "import": "./dist/header-portal.js",
        "types": "./dist/header-portal.d.ts"
      },
      "./esp32-flasher/router": {
        "import": "./dist/esp32-flasher/router.js",
        "types": "./dist/esp32-flasher/router.d.ts"
      }
    }
  },
  "dependencies": {
    "@helix/backend": "workspace:*",
    "@helix/design-system": "workspace:*",
    "@helix/esp32-flasher": "workspace:*",
    "@helix/protocol-peer": "workspace:*",
    "@helix/protocol-service": "workspace:*",
    "@helix/protocol-stream": "workspace:*",
    "@helix/transport-mqtt": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "lucide-react": "^1.23.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2"
  }
}
