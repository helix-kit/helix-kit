{
  "name": "@helix-hq/ai-kit",
  "version": "0.1.1",
  "description": "Contracts for composing AI assistants: prompt sections, tool sets and streamed artifacts, contributed by independent packages.",
  "keywords": [
    "ai",
    "llm",
    "assistant",
    "tools",
    "prompt",
    "artifacts",
    "vercel-ai-sdk"
  ],
  "license": "MIT",
  "author": "Hardik Jain",
  "homepage": "https://github.com/helix-kit/helix-kit/tree/main/web/packages/ai-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helix-kit/helix-kit.git",
    "directory": "web/packages/ai-kit"
  },
  "bugs": {
    "url": "https://github.com/helix-kit/helix-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ai-sdk": {
      "types": "./src/ai-sdk.ts",
      "import": "./src/ai-sdk.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "import": "./src/fixtures.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ai-sdk": {
        "types": "./dist/ai-sdk.d.ts",
        "import": "./dist/ai-sdk.js"
      },
      "./fixtures": {
        "types": "./dist/fixtures.d.ts",
        "import": "./dist/fixtures.js"
      }
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ai": "^7.0.42",
    "eslint": "^10.6.0",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  }
}
