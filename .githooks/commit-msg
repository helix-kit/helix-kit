#!/usr/bin/env bash
# Helix commit-msg hook: require a Linear tracking id (HELIX-<number>) in every
# commit message, so each commit maps back to its tracked issue.
# See the linear-tracking skill (.claude/skills/linear-tracking/).
set -uo pipefail

msg_file="$1"

# Skip merge commits — their message is auto-generated by git.
if [[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]]; then
    exit 0
fi

# Only look at the real message: drop comment lines (and, with verbose commits,
# the diff below the scissors line that git already comments out).
msg="$(git stripspace --strip-comments < "$msg_file")"

# Autosquash commits fold into a target that already carries the id — let them by.
first_line="$(printf '%s\n' "$msg" | sed -n '1p')"
case "$first_line" in
    fixup!*|squash!*|amend!*) exit 0 ;;
esac

# Pass if the message references at least one Linear issue: HELIX-<number>.
if printf '%s' "$msg" | grep -Eq '\bHELIX-[0-9]+\b'; then
    exit 0
fi

cat >&2 <<'EOF'

  Commit rejected: no Linear tracking id in the commit message.

  Every Helix commit must reference its Linear issue, e.g.:

      HELIX-123: validate gateway session token

      <longer description>

      Refs: HELIX-123

  Add the HELIX-<number> for the issue you are working on, then commit again.
  (Find or open the issue per the linear-tracking skill.)

EOF
exit 1
