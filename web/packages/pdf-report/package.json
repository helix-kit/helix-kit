{
  "name": "@helix-hq/pdf-report",
  "version": "0.1.0",
  "description": "JSON-defined PDF reports: a sandboxed code step computes the values, a json-render layout places them.",
  "keywords": [
    "pdf",
    "reports",
    "react-pdf",
    "json-render",
    "report-builder",
    "template-editor",
    "react"
  ],
  "license": "MIT",
  "author": "Hardik Jain",
  "homepage": "https://github.com/helix-kit/helix-kit/tree/main/web/packages/pdf-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helix-kit/helix-kit.git",
    "directory": "web/packages/pdf-report"
  },
  "bugs": {
    "url": "https://github.com/helix-kit/helix-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:live": "vitest run ai.live",
    "build:css": "pnpm exec tailwindcss -i ./src/styles/editor.css -o ./dist/styles/editor.css --minify"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./ai": {
      "import": "./src/ai.ts",
      "types": "./src/ai.ts"
    },
    "./browser": {
      "import": "./src/browser.tsx",
      "types": "./src/browser.tsx"
    },
    "./components": {
      "import": "./src/components/registry.ts",
      "types": "./src/components/registry.ts"
    },
    "./editor": {
      "import": "./src/editor.tsx",
      "types": "./src/editor.tsx"
    },
    "./editor.css": "./src/styles/editor.css",
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./ai": {
        "import": "./dist/ai.js",
        "types": "./dist/ai.d.ts"
      },
      "./browser": {
        "import": "./dist/browser.js",
        "types": "./dist/browser.d.ts"
      },
      "./components": {
        "import": "./dist/components/registry.js",
        "types": "./dist/components/registry.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.js",
        "types": "./dist/editor.d.ts"
      },
      "./editor.css": "./dist/styles/editor.css",
      "./server": {
        "import": "./dist/server.js",
        "types": "./dist/server.d.ts"
      }
    }
  },
  "dependencies": {
    "@helix-hq/ai-kit": "workspace:*",
    "@helix-hq/code-executor": "workspace:*",
    "@helix-hq/json-schema": "workspace:*",
    "@json-render/core": "^0.19.0",
    "@json-render/react-pdf": "^0.19.0",
    "@react-pdf/renderer": "^4.5.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@helix-hq/design-system": "workspace:*",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ai": "^7.0.42",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
