# SPDX-License-Identifier: AGPL-3.0-only
# GPU-resident x86 build (inside helix-x86-cuda-base): CUDA-OpenCV (/usr/local) + ONNX Runtime +
# GStreamer. Adds hx_infer_ort_gpu (cv::cuda preprocess + ORT IoBinding) and hx_pre_passthrough.
ORT  ?= /opt/onnxruntime
CUDA ?= /usr/local/cuda
CXX  ?= g++
OPT  ?= -O2

# OpenCV built from source to /usr/local (no opencv4.pc generated) — hardcode include/libs.
PKG_CV  := -I/usr/local/include/opencv4
LCV     := -L/usr/local/lib -Wl,-rpath,/usr/local/lib \
           -lopencv_cudawarping -lopencv_cudaimgproc -lopencv_cudaarithm \
           -lopencv_imgcodecs -lopencv_imgproc -lopencv_cudev -lopencv_core
PKG_GST := $(shell pkg-config --cflags gstreamer-1.0)
LGST    := $(shell pkg-config --libs gstreamer-1.0)
LGSTAPP := $(shell pkg-config --libs gstreamer-app-1.0)
SO      := $(OPT) -fPIC -I. -shared
HDR     := helix_pipeline.h hx_json.h

PLUGINS := hx_src_gst.so hx_pre_letterbox.so hx_pre_passthrough.so \
           hx_infer_ort.so hx_infer_ort_gpu.so \
           hx_post_yolov5.so hx_post_yolo11.so hx_post_pose.so \
           hx_overlay_boxes.so hx_overlay_pose.so hx_comp_grid.so hx_sink_gst.so

all: helix_pipeline $(PLUGINS)

helix_pipeline: helix_pipeline.cpp $(HDR)
	$(CXX) $(OPT) -I. $(PKG_CV) $(PKG_GST) helix_pipeline.cpp -o $@ $(LGST) $(LCV) -ldl -lpthread

hx_src_gst.so: src_gst/hx_src_gst.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $(PKG_GST) $< -o $@ $(LGST) $(LGSTAPP)
hx_sink_gst.so: sink_gst/hx_sink_gst.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $(PKG_GST) $< -o $@ $(LGST) $(LGSTAPP)

hx_pre_passthrough.so: pre_passthrough/hx_pre_passthrough.cpp $(HDR)
	$(CXX) $(SO) $< -o $@
hx_pre_letterbox.so: pre_letterbox/hx_pre_letterbox.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_post_yolov5.so: post_yolov5/hx_post_yolov5.cpp $(HDR) hx_detect_common.h
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_post_yolo11.so: post_yolo11/hx_post_yolo11.cpp $(HDR) hx_detect_common.h
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_post_pose.so: post_pose/hx_post_pose.cpp $(HDR) hx_detect_common.h
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_overlay_boxes.so: overlay_boxes/hx_overlay_boxes.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_overlay_pose.so: overlay_pose/hx_overlay_pose.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)
hx_comp_grid.so: comp_grid/hx_comp_grid.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) $< -o $@ $(LCV)

# CPU/CUDA ORT (no cv::cuda) — the portable ORT infer
hx_infer_ort.so: infer_ort/hx_infer_ort.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) -I$(ORT)/include infer_ort/hx_infer_ort.cpp -o $@ \
	    -L$(ORT)/lib -Wl,-rpath,$(ORT)/lib -lonnxruntime

# GPU-resident: cv::cuda preprocess + ORT IoBinding + cudart
hx_infer_ort_gpu.so: infer_ort_gpu/hx_infer_ort_gpu.cpp $(HDR)
	$(CXX) $(SO) $(PKG_CV) -I$(ORT)/include -I$(CUDA)/include infer_ort_gpu/hx_infer_ort_gpu.cpp -o $@ \
	    $(LCV) -L$(ORT)/lib -Wl,-rpath,$(ORT)/lib -lonnxruntime -L$(CUDA)/lib64 -lcudart

clean:
	rm -f helix_pipeline $(PLUGINS)

.PHONY: all clean
