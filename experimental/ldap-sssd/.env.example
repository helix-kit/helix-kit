# SPDX-License-Identifier: AGPL-3.0-only
# Development-only credentials for the isolated experiment. Not a production
# design: see README "Deferred production concerns".

POSTGRES_DB=helix
POSTGRES_USER=helix
POSTGRES_PASSWORD=dev-only-password

DATABASE_URL=postgres://helix:dev-only-password@postgres:5432/helix?sslmode=disable

LDAP_LISTEN_ADDR=:3389
LDAP_BASE_DN=dc=helix,dc=local
LDAP_BIND_DN=cn=sssd,dc=helix,dc=local
LDAP_BIND_PASSWORD=dev-only-password
LDAP_SEARCH_LIMIT=1000

HELIX_HOME_ROOT=/home
HELIX_LOGIN_SHELL=/usr/libexec/helix/session-launcher

LOG_LEVEL=info
# Set to true to dump raw LDAP packets (very noisy).
LDAP_WIRE_TRACE=false

# Host port the LDAP facade is published on, for manual ldapsearch. It is NOT
# 3389 because that is RDP, which gnome-remote-desktop and xrdp commonly hold.
# Inside the compose network the facade always listens on 3389.
LDAP_HOST_PORT=23389
SSSD_DEBUG_LEVEL=2
