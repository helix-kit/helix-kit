{
  "name": "@helix-hq/device-apps",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./esp32-flasher": {
      "types": "./src/esp32-flasher/flash.ts",
      "import": "./src/esp32-flasher/flash.ts"
    },
    "./esp32-flasher/router": {
      "types": "./src/esp32-flasher/router.ts",
      "import": "./src/esp32-flasher/router.ts"
    },
    "./header-portal": {
      "types": "./src/header-portal.tsx",
      "import": "./src/header-portal.tsx"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./header-portal": {
        "types": "./dist/header-portal.d.ts",
        "import": "./dist/header-portal.js"
      },
      "./esp32-flasher/router": {
        "types": "./dist/esp32-flasher/router.d.ts",
        "import": "./dist/esp32-flasher/router.js"
      }
    }
  },
  "dependencies": {
    "@helix-hq/backend": "workspace:*",
    "@helix-hq/design-system": "workspace:*",
    "@helix-hq/protocol": "workspace:*",
    "@helix-hq/web-core": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esptool-js": "^0.6.0",
    "lucide-react": "^1.23.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@tsdown/css": "0.22.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2"
  }
}
