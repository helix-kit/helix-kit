#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-only
#
# Lab helper: point helix-authd at a different cloud and restart it. Used by the
# harness to take the control plane away and watch what each method does.
set -euo pipefail

url="${1:?usage: set-cloud-url <base-url>}"
python3 - "$url" <<'PY'
import json, sys
path = "/etc/helix/conf.d/helix-authd.json"
with open(path) as handle:
    config = json.load(handle)
config.setdefault("cloud", {})["authUrl"] = sys.argv[1]
config["cloud"]["gatewayUrl"] = sys.argv[1]
with open(path, "w") as handle:
    json.dump(config, handle, indent=2)
PY

pkill -f '/usr/local/bin/helix-authd' || true
for _ in $(seq 1 20); do
    [ -S /run/helix/authd/auth.sock ] || break
    sleep 0.2
done

helix-authd >>/var/log/helix-authd.log 2>&1 &
for _ in $(seq 1 40); do
    if [ -S /run/helix/authd/auth.sock ]; then
        echo "helix-authd restarted against ${url}"
        exit 0
    fi
    sleep 0.25
done
echo "helix-authd did not come back" >&2
exit 1
