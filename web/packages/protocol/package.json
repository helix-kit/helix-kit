{
  "name": "@helix/protocol",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./ble": {
      "import": "./src/ble/index.tsx",
      "types": "./src/ble/index.tsx"
    },
    "./mqtt": {
      "import": "./src/mqtt/index.ts",
      "types": "./src/mqtt/index.ts"
    },
    "./mqtt/react": {
      "import": "./src/mqtt/react.tsx",
      "types": "./src/mqtt/react.tsx"
    },
    "./peer": {
      "import": "./src/peer/index.ts",
      "types": "./src/peer/index.ts"
    },
    "./serial": {
      "import": "./src/serial/index.ts",
      "types": "./src/serial/index.ts"
    },
    "./serial/react": {
      "import": "./src/serial/react.tsx",
      "types": "./src/serial/react.tsx"
    },
    "./service": {
      "import": "./src/service/index.ts",
      "types": "./src/service/index.ts"
    },
    "./service/react": {
      "import": "./src/service/react.tsx",
      "types": "./src/service/react.tsx"
    },
    "./stream": {
      "import": "./src/stream/index.ts",
      "types": "./src/stream/index.ts"
    },
    "./websocket": {
      "import": "./src/websocket/index.ts",
      "types": "./src/websocket/index.ts"
    },
    "./websocket/react": {
      "import": "./src/websocket/react.tsx",
      "types": "./src/websocket/react.tsx"
    }
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.96.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.6.0",
    "react": "19.2.7",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./ble": {
        "import": "./dist/ble/index.js",
        "types": "./dist/ble/index.d.ts"
      },
      "./mqtt": {
        "import": "./dist/mqtt/index.js",
        "types": "./dist/mqtt/index.d.ts"
      },
      "./mqtt/react": {
        "import": "./dist/mqtt/react.js",
        "types": "./dist/mqtt/react.d.ts"
      },
      "./peer": {
        "import": "./dist/peer/index.js",
        "types": "./dist/peer/index.d.ts"
      },
      "./serial": {
        "import": "./dist/serial/index.js",
        "types": "./dist/serial/index.d.ts"
      },
      "./serial/react": {
        "import": "./dist/serial/react.js",
        "types": "./dist/serial/react.d.ts"
      },
      "./service": {
        "import": "./dist/service/index.js",
        "types": "./dist/service/index.d.ts"
      },
      "./service/react": {
        "import": "./dist/service/react.js",
        "types": "./dist/service/react.d.ts"
      },
      "./stream": {
        "import": "./dist/stream/index.js",
        "types": "./dist/stream/index.d.ts"
      },
      "./websocket": {
        "import": "./dist/websocket/index.js",
        "types": "./dist/websocket/index.d.ts"
      },
      "./websocket/react": {
        "import": "./dist/websocket/react.js",
        "types": "./dist/websocket/react.d.ts"
      }
    }
  }
}
