{
  "name": "helix-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build --continue=always",
    "dev": "turbo run dev",
    "lint": "turbo run lint --continue=always",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,mjs}\"",
    "typecheck": "turbo run typecheck --continue=always",
    "exports:check": "tsx ./scripts/sync-package-exports.ts",
    "exports:sync": "tsx ./scripts/sync-package-exports.ts --write",
    "api:check": "tsx ./scripts/api-report.ts",
    "api:update": "tsx ./scripts/api-report.ts --update",
    "publint": "tsx ./scripts/check-packaging.ts",
    "changeset": "changeset",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "unused": "tsx ./scripts/run-unused.ts",
    "unused:fix": "knip --fix --fix-type exports,types --format",
    "unused:trpc": "tsx ./scripts/check-trpc-procedure-usage.ts",
    "update:check": "npm-check-updates --deep --errorLevel 2 --reject recharts,html-to-image",
    "update:apply": "npm-check-updates --deep -u --reject recharts,html-to-image",
    "clean": "find . -type d \\( -name node_modules -o -name .next -o -name .turbo -o -name dist \\) -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.1",
    "@workspace/typescript-config": "workspace:*",
    "knip": "^6.25.0",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.23",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@^6.0.3"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  }
}
