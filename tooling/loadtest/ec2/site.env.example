# Appliance site.env for a DBOS-mode load-test box. Mounted at
# /etc/helix/site.env (ro). Replace the domain with your box's nip.io name
# (<dash-encoded-public-ip>.nip.io) and set a real sysadmin password.
APP_DOMAIN=REPLACE-ME.nip.io
PUBLIC_APP_URL=https://REPLACE-ME.nip.io
ACME_EMAIL=ops@example.com

# Workflow: DBOS engine, in-process, checkpoints to Postgres `dbos` schema.
# `dispatch` MUST be in the roles or NO workflows run (default roles are
# gateway,ingest,writer only).
HELIX_SERVER_ROLES=gateway,ingest,writer,dispatch
HELIX_WORKFLOW_MODE=dbos
HELIX_DBOS_SCHEMA=dbos
HELIX_WORKFLOW_CONCURRENCY=100
HELIX_WORKFLOW_QUERY_MS=20
HELIX_WORKFLOW_LLM_MS=200
HELIX_WORKFLOW_NOTIFY_MS=30
HELIX_WORKFLOW_LLM_MODE=blocking

STORAGE_PROVIDER=FS
FS_STORAGE_ROOT=/var/lib/helix/storage
EMAIL_LOG_CONTENT=true

# First sysadmin — better-auth still requires a signup + role promotion (see
# README); these seed values are only used if the cloud-init seed CLI is present.
LOCAL_SYSADMIN_EMAIL=admin@helix.test
LOCAL_SYSADMIN_NAME=Administrator
LOCAL_SYSADMIN_PASSWORD=CHANGE-ME

ENABLE_OBSERVABILITY=0
