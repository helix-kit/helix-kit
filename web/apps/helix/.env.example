# helix — cloud app (Next.js UI). Copy to `.env` and fill in, or let
# `helix appliance up` generate a `.env` wired to the local appliance for you.
#
# Values marked [appliance] are (re)written from the running appliance container
# by `helix appliance up`. Everything else is yours to edit.

# ---- [appliance] Postgres over the appliance's mapped host port ----
DATABASE_URL=postgres://helix:PASSWORD@127.0.0.1:25432/helix

# ---- [appliance] Better Auth session-signing secret (shared with the server) ----
BETTER_AUTH_SECRET=change-me

# Canonical origin (falls back to NEXT_PUBLIC_BASE_URL when unset).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SMTP transport for verification / password-reset mail. Leave SMTP_SERVER
# empty to skip delivery (the action link is logged instead). Accepts a bare
# host or an smtp://|smtps:// URL.
SMTP_SERVER=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# When 'true', log the full content of every outbound email via the logger.
EMAIL_LOG_CONTENT=true

# ---- [appliance] step-ca wiring for the admin certificate-revocation surface ----
# The /device/[id] Certificates panel revokes device certs via step-ca. Optional:
# unset leaves certificate listing working but revoke disabled. Same values
# helix-server uses (host-mapped step-ca port + exported PKI).
MQTT_STEP_CA_URL=https://127.0.0.1:29000
MQTT_STEP_CA_ROOT_CERT_PATH=../helix-server/.dev-pki/root_ca.crt
MQTT_STEP_CA_DEVICE_PROVISIONER_NAME=helix-device
MQTT_STEP_CA_DEVICE_PROVISIONER_JWK_PATH=../helix-server/.dev-pki/device-provisioner.jwk.json
