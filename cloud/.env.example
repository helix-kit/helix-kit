APP_DOMAIN=gateway.example.com
PUBLIC_APP_URL=https://gateway.example.com
ACME_EMAIL=ops@example.com
# Optional comma-separated extra DNS names to include on the Mosquitto server certificate.
# For public device connectivity, include the broker hostname clients will validate, for example:
# MQTT_BROKER_PUBLIC_HOSTS=gateway.example.com
MQTT_BROKER_PUBLIC_HOSTS=

# Internal upstream for the gateway proxy.
LIVE_GATEWAY_UPSTREAM=live-gateway:4000
NEXTJS_UPSTREAM=helix:3000
TURBO_CACHE_UPSTREAM=turbo-cache:3000

# Turborepo remote cache. Generate the token with: openssl rand -hex 32
# Configure GitHub Actions with:
#   env/variable TURBO_API=https://gateway.example.com/turbo-cache
#   env/variable TURBO_TEAM=helix
#   secret       TURBO_TOKEN=<same value as below>
TURBO_TOKEN=change-me
TURBO_CACHE_BODY_LIMIT=104857600
TURBO_CACHE_LOG_LEVEL=info
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Live-gateway runtime settings.
DEVICE_ID=default
LIVE_GATEWAY_AUTH_SECRET=helix-local-gateway-secret
# Comma-separated browser origins allowed to call the live-gateway API directly.
# Include localhost when you want the local app to talk to the deployed gateway.
CORS_ALLOWED_ORIGINS=https://gateway.example.com,http://localhost:3000
# Comma-separated TURN urls let the browser fall back from UDP to TCP.
TURN_SERVER_URL=turn:gateway.example.com:3478?transport=udp,turn:gateway.example.com:3478?transport=tcp

# Next.js cloud app runtime settings.
BETTER_AUTH_SECRET=change-me
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_NAME=helix
MQTT_STEP_CA_URL=https://step-ca:9000
MQTT_STEP_CA_ROOT_CERT_PATH=/run/helix-step-ca/certs/root_ca.crt
MQTT_STEP_CA_DEVICE_PROVISIONER_NAME=helix-device
MQTT_STEP_CA_DEVICE_PROVISIONER_JWK_PATH=/run/helix-step-ca/jwk/device-provisioner.jwk.json
MICROSOFT_CLIENT_ID=local-dev-placeholder
MICROSOFT_CLIENT_SECRET=local-dev-placeholder
MICROSOFT_TENANT_ID=common
SMTP_SERVER=smtp://smtp.example.com:587
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_SENDER_ADDRESS=dev@example.com
STORAGE_PROVIDER=S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=helix
HELIX_PACKAGE_RELEASE_TOKEN=
LOCAL_SYSADMIN_EMAIL=
LOCAL_SYSADMIN_NAME=
LOCAL_SYSADMIN_PASSWORD=

# Coturn — the TURN relay for the WebRTC data plane (used only when a device and a
# browser cannot find a direct path). Public/private addressing for the same EC2
# host: coturn binds the private address but must advertise the public one, or it
# hands out relay candidates nobody can reach. With host networking on Linux EC2,
# TURN_PRIVATE_IP can stay blank unless you need to override it.
TURN_PUBLIC_IP=
TURN_PRIVATE_IP=
# Signs the short-lived TURN credentials /api/ice-config mints per authenticated
# user; coturn verifies them with the same secret (its `use-auth-secret` model).
# Generate with: openssl rand -hex 32
# NB: there is deliberately no shared TURN username/password — a static credential
# on a public box is an open relay anyone can push traffic through.
TURN_STATIC_AUTH_SECRET=
# Defaults to APP_DOMAIN.
TURN_REALM=

# ---------------------------------------------------------------------------
# Cloud app images. The single docker-compose.yml gives each app service both an
# `image:` and a `build:`, so the source is chosen by whether these are set:
#   - SET (these vars)  -> deploy pulls the GHCR image by tag (production path;
#                          `deploy-cloud.sh` runs `docker compose pull`).
#   - UNSET             -> docker compose builds the image locally from source.
# CI publishes these on push to main. Replace <owner> with your GitHub org/user
# (lowercase). Leave them unset/commented for a from-source local build.
# ---------------------------------------------------------------------------
HELIX_CLOUD_APP_IMAGE=ghcr.io/<owner>/helix-cloud-app:latest
HELIX_CLOUD_INIT_IMAGE=ghcr.io/<owner>/helix-cloud-init:latest
HELIX_LIVE_GATEWAY_IMAGE=ghcr.io/<owner>/helix-live-gateway:latest
HELIX_WORKFLOW_SCHEDULER_IMAGE=ghcr.io/<owner>/helix-workflow-scheduler:latest
HELIX_WORKFLOW_EVENT_DISPATCHER_IMAGE=ghcr.io/<owner>/helix-workflow-event-dispatcher:latest

# ---------------------------------------------------------------------------
# Observability (opt-in `observability` compose profile: Grafana, Prometheus,
# Loki, Tempo, Alloy, exporters). Start it with:
#   docker compose -f docker-compose.yml --env-file .env --profile observability up -d
# Log shipping (Alloy -> Loki) needs no app config. To also send app TRACES to
# the bundled otel-collector (Tempo), uncomment these so they reach the app:
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Inngest + workflow stack. `inngest start` (self-hosted, production mode)
# REQUIRES both keys, and they must be raw hex strings shared by the Inngest
# server, the cloud app, and the event dispatcher. Generate each with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
INNGEST_POSTGRES_DB=inngest
INNGEST_POSTGRES_USER=inngest
INNGEST_POSTGRES_PASSWORD=password
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
EVENT_QUEUE_TOPIC=helix.device-events.v1
# Internal URLs the workflow services use to reach each other.
HELIX_WORKFLOW_BASE_URL=http://helix:3000
HELIX_INNGEST_BASE_URL=http://inngest:8288
HELIX_WORKFLOW_SCHEDULER_URL=http://helix-workflow-scheduler:3010
# Shared bearer token authenticating cron-trigger calls between the cloud app
# and the workflow scheduler. Generate with: openssl rand -hex 32
WORKFLOW_SERVICE_TOKEN=
