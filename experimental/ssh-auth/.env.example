# Development-only credentials for the isolated experiment.

POSTGRES_DB=helix
POSTGRES_USER=helix
POSTGRES_PASSWORD=dev-only-password
DATABASE_URL=postgres://helix:dev-only-password@postgres:5432/helix?sslmode=disable

LDAP_BIND_PASSWORD=dev-only-password

# The login shell the LDAP facade projects. sshd's ForceCommand runs regardless,
# but the shell must exist on the device for the session to start at all.
HELIX_LOGIN_SHELL=/bin/bash

LOG_LEVEL=info
SSSD_DEBUG_LEVEL=2

# Set false to prove sshd fails closed when the authentication engine is absent.
HELIX_AUTHD_ENABLED=true
