{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@helix/design-system/*": ["../../packages/helix-design-system/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "eslint.config.mjs",
    "src/app/.well-known/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
